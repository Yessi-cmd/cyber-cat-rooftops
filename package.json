{
  "name": "cyber-cat-rooftops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:server": "tsc -p tsconfig.server.build.json",
    "race-server": "npm run build:server && node build/server/main.js",
    "deploy:vps": "bash scripts/deploy-vps.sh",
    "deploy:race": "bash scripts/deploy-race-server.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
